# ──────────────────────────────────────────���──────────────────────────────────
#  Aula IT — environment configuration
#
#  Copy to .env.local and fill in the values:
#      cp .env.example .env.local
#
#  .env.local is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ─────────────────────────────────────────────────────
# Create a project at https://supabase.com, then read the values from
# Settings → API. Apply the schema with:  supabase db push

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER expose this to the browser.
# It bypasses Row Level Security — treat it as a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site (REQUIRED) ─────────────────────────────────────────────────────────
# Used to build auth callback redirects (e.g. `${NEXT_PUBLIC_SITE_URL}/auth/callback`).
# Must match the origin the app is served from, without a trailing slash.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Drive / OAuth (REQUIRED for Drive features) ──────────────────────
# Create OAuth 2.0 credentials in the Google Cloud Console, enable the Drive
# API, and register the redirect URI below exactly:
#     ${NEXT_PUBLIC_SITE_URL}/api/drive/callback

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# ── Google Drive Picker (OPTIONAL) ──────────────────────────────────────────
# Enables the in-app Google Picker used to select files from Drive.
# Create an API key with the "Google Drive API" restriction in the Cloud Console.
# Without these, the app falls back to manual Drive URL entry.

NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ── Animations (OPTIONAL) ───────────────────────────────────────────────────
# Base URL of the standalone learning-animations service, which serves
# educational animations at ${NEXT_PUBLIC_ANIMATIONS_URL}/embed/{slug}.
# Defaults to http://localhost:3001 when unset. The animation steps in an
# activity simply render empty if the service is unreachable.

NEXT_PUBLIC_ANIMATIONS_URL=http://localhost:3001

# ── PDF generation (SERVER ONLY, OPTIONAL) ──────────────────────────────────
# Used by app/actions/generate-pdf.ts to download a headless Chromium binary
# for server-side PDF export. Leave unset on local development — the binary is
# resolved from the local node_modules install instead. On serverless hosts
# such as Vercel, set this to a reachable CDN URL.

CHROMIUM_EXECUTABLE_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  First admin account
#
#  There is no signup-to-admin path. Register through /login/teacher, then run
#  this in the Supabase SQL editor:
#
#      UPDATE public.profiles SET role = 'admin' WHERE email = 'you@example.com';
#
#  The /admin panel (teacher and student management) stays hidden until then.
# ─────────────────────────────────────────────────────────────────────────────
